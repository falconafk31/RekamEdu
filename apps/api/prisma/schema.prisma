// ============================================================================
// Skema database RekamEdu — fondasi Tahap 0.
// Konvensi: nama TABEL snake_case via @@map; multi-tenant shared schema.
// SEMUA tabel data tenant WAJIB punya kolom tenantId + @@index([tenantId, ...]).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum Role {
  OWNER // platform (tenantId NULL) — bukan bagian tenant mana pun
  ADMIN // full akses dalam satu tenant
  KEPALA_SEKOLAH // full akses dalam satu tenant
  GURU // modul 1, 2, 3 (modul belum diimplementasi — hanya role-nya)
  PUSTAKAWAN // modul 4 (modul belum diimplementasi — hanya role-nya)
  TU // modul 5 (modul belum diimplementasi — hanya role-nya)
}

enum Plan {
  trial
  pro
  custom
}

enum SubscriptionStatus {
  active
  expired
  suspended
}

// ---------------------------------------------------------------------------
// Enum Modul 1 (Presensi) & Modul 4 (Perpustakaan) — Tahap 1
// ---------------------------------------------------------------------------

enum JenisKelamin {
  L
  P
}

enum StatusSiswa {
  aktif
  lulus
  pindah
  keluar
}

enum StatusPresensi {
  Hadir
  Izin
  Sakit
  Alfa
}

enum StatusHari {
  Masuk
  Libur
}

enum Semester {
  Ganjil
  Genap
}

enum StatusPinjaman {
  dipinjam
  dikembalikan
  terlambat
  hilang
}

// ---------------------------------------------------------------------------
// Tenant & identitas
// ---------------------------------------------------------------------------

model Tenant {
  id               String   @id @default(uuid())
  kodeSekolah      String   @unique // dipakai saat login: kode_sekolah + username
  nama             String
  npsn             String?
  alamat           String?
  telepon          String?
  email            String?
  logoUrl          String?
  kepalaSekolah    String?
  nipKepalaSekolah String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  subscription Subscription?

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  // NULL khusus Owner platform — baris Owner tidak terikat tenant mana pun.
  tenantId     String?
  username     String
  passwordHash String // hash argon2id
  role         Role
  nama         String? // nama tampilan (dipakai modul presensi/perpus)
  kelas        String? // assignment wali kelas untuk role GURU (modul 1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Langganan (diblokir oleh SubscriptionGuard bila expired/suspended)
// ---------------------------------------------------------------------------

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String             @unique
  plan      Plan
  status    SubscriptionStatus
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// AI terpusat: API key milik Owner, terenkripsi AES-256-GCM.
// Key TIDAK PERNAH dikirim ke frontend.
// ---------------------------------------------------------------------------

model AiModel {
  id           String   @id @default(uuid())
  provider     String // mis. "openai"
  model        String // mis. "gpt-4o-mini"
  displayName  String
  encryptedKey String   @db.Text // hasil encrypt() dari src/common/crypto/aes-gcm.ts
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  planLinks PlanAiModel[]
  usageLogs AiUsageLog[]

  @@unique([provider, model])
  @@map("ai_models")
}

model PlanAiModel {
  id        String @id @default(uuid())
  plan      Plan
  aiModelId String

  aiModel AiModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)

  @@unique([plan, aiModelId])
  @@index([plan])
  @@map("plan_ai_models")
}

model AiUsageLog {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  aiModelId    String
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  createdAt    DateTime @default(now())

  aiModel AiModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  aksi        String
  tabelTerkait String? // nama tabel/entitas terkait (port activity_logs Tahap 1)
  recordId    String? // id record terkait (port activity_logs Tahap 1)
  detail      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// MODUL 1 — Presensi Siswa (Tahap 1)
// Pola tenantId mengikuti AiUsageLog: kolom scalar tanpa relasi balik ke
// Tenant; isolasi dijamin middleware tenantPrismaMiddleware.
// ---------------------------------------------------------------------------

model Student {
  id            String       @id @default(uuid())
  tenantId      String
  nisn          String
  nama          String
  jk            JenisKelamin?
  kelas         String?
  active        Boolean      @default(true)
  status        StatusSiswa  @default(aktif)
  tanggalMasuk  DateTime?    @db.Date
  tanggalKeluar DateTime?    @db.Date
  keterangan    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attendanceLogs AttendanceLog[]
  classHistories ClassHistory[]
  bookLoans      BookLoan[]
  libraryVisits  LibraryVisit[]

  @@unique([tenantId, nisn])
  @@index([tenantId, kelas])
  @@index([tenantId, status])
  @@map("students")
}

model AttendanceLog {
  id        String         @id @default(uuid())
  tenantId  String
  date      DateTime       @db.Date
  studentId String
  status    StatusPresensi
  kelas     String?
  guruInput String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, studentId])
  @@index([tenantId, date])
  @@map("attendance_logs")
}

model AcademicCalendar {
  tenantId String
  date     DateTime   @db.Date
  status   StatusHari @default(Masuk)

  @@id([tenantId, date])
  @@map("academic_calendar")
}

model AcademicPeriod {
  id          String   @id @default(uuid())
  tenantId    String
  tahunAjaran String
  semester    Semester
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([tenantId, tahunAjaran, semester])
  @@index([tenantId, isActive])
  @@map("academic_periods")
}

model ClassHistory {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  tahunAjaran String
  kelas       String?
  waliKelas   String?
  status      String?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, tahunAjaran])
  @@index([tenantId, tahunAjaran])
  @@map("class_history")
}

model TenantSetting {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  namaSekolah       String?
  alamat            String?
  kepalaSekolah     String?
  nipKepalaSekolah  String?
  logoUrl           String?
  daftarKelas       Json     @default("[]")
  kopBaris2         String?
  kopBaris3         String?
  kopBaris4         String?
  kopBaris5         String?
  namaPerpustakaan  String?
  hariLiburMingguan Json     @default("[0, 6]")
  updatedAt         DateTime @updatedAt

  @@map("tenant_settings")
}

// ---------------------------------------------------------------------------
// MODUL 4 — Perpustakaan (Tahap 1)
// ---------------------------------------------------------------------------

model Book {
  id          String   @id @default(uuid())
  tenantId    String
  judul       String
  pengarang   String?
  penerbit    String?
  tahunTerbit String?
  isbn        String?
  stok        Int      @default(1)
  kategori    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loans BookLoan[]

  @@index([tenantId, kategori])
  @@index([tenantId, judul])
  @@map("books")
}

model BookLoan {
  id                       String         @id @default(uuid())
  tenantId                 String
  bookId                   String
  studentId                String
  tanggalPinjam            DateTime       @db.Date
  tanggalKembaliSeharusnya DateTime       @db.Date
  tanggalKembaliAktual     DateTime?      @db.Date
  status                   StatusPinjaman @default(dipinjam)
  guruInput                String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, tanggalPinjam])
  @@map("book_loans")
}

model LibraryVisit {
  id        String   @id @default(uuid())
  tenantId  String
  studentId String
  tanggal   DateTime @db.Date
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, tanggal])
  @@index([tenantId, studentId])
  @@map("library_visits")
}
