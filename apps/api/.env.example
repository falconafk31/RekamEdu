# Contoh environment RekamEdu API (Tahap 0).
# Salin menjadi .env lalu isi nilainya. JANGAN commit .env ke git.

# Koneksi PostgreSQL (wajib)
DATABASE_URL=postgresql://rekamedu:secret@localhost:5432/rekamedu?schema=public

# Redis untuk cache / rate-limit / queue (rencana tahap berikutnya)
REDIS_URL=redis://localhost:6379

# Secret JWT — isi dengan string acak yang panjang & berbeda satu sama lain
JWT_ACCESS_SECRET=ganti-dengan-secret-access-yang-panjang-dan-acak
JWT_REFRESH_SECRET=ganti-dengan-secret-refresh-yang-panjang-dan-acak

# Kunci enkripsi AES-256-GCM untuk API key AI milik Owner.
# WAJIB 64 karakter hex (= 32 byte). Contoh dibuat dengan:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# MinIO (penyimpanan file)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ganti-dengan-password-minio

# Port aplikasi (default 3000 bila tidak diisi)
APP_PORT=3000

# Seed Tahap 0
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=
