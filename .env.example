# ============================================================
# RekamEdu — contoh environment variables
# Salin ke .env lalu isi nilai yang sebenarnya:
#   cp .env.example .env
# JANGAN commit file .env ke git.
# ============================================================

# --- Database PostgreSQL ---
DATABASE_URL=postgresql://rekamedu:rekamedu@postgres:5432/rekamedu

# --- Redis (cache & rate limit) ---
REDIS_URL=redis://redis:6379

# --- JWT (self-managed) ---
# GANTI dengan string acak minimal 32 karakter, berbeda satu sama lain.
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-min-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-min-32-karakter

# --- MinIO (object storage S3-compatible) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=ganti-dengan-username-minio
MINIO_ROOT_PASSWORD=ganti-dengan-password-minio-min-8-karakter

# --- Enkripsi API key provider AI (AES-256-GCM) ---
# 64 karakter HEX (32 byte). Contoh format saja — BUKAN nilai asli:
#   hasilkan dengan: openssl rand -hex 32
ENCRYPTION_KEY=ganti-dengan-64-karakter-hex-dari-openssl-rand-hex-32

# --- Caddy / domain publik ---
DOMAIN=rekamedu.local

# --- Port API untuk akses langsung (dev) ---
APP_PORT=3000

# --- Seed awal (Tahap 1) ---
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ganti-dengan-password-owner-kuat
SEED_DEMO_ADMIN_PASSWORD=ganti-dengan-password-admin-demo
